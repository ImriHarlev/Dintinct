          <mxGeometry x="879" y="608" width="244" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r-note" value="Network A: mini-manifest written BEFORE DB commit.&#xa;If crash between file-write and commit:&#xa;RabbitMQ redelivers (channel close) → retry →&#xa;re-writes same mini-manifest (idempotent) →&#xa;done-CAS commits (exactly-once via status guard)." style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="1148" y="248" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="r-note-b" value="Network B permanent failure (no r0/r1 steps):&#xa;done-CAS expected_file SET status=&#39;Failed&#39;,&#xa;failure_reason → nack → *.dead. Job continues.&#xa;NO mini-manifest on B — Reporter learns of&#xa;the failure directly from expected_file.status." style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="1148" y="344" width="260" height="100" as="geometry" />
        </mxCell>
