        <mxCell id="EaYgT6YETIj5RXNyyErW-2" value="&amp;nbsp;DLX" style="text;html=1;strokeColor=none;fillColor=none;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="1131" y="476" width="50" height="16" as="geometry" />
        </mxCell>
        <mxCell id="whitelist" value="Eample:&#xa;Transient (retry):&#xa;  SqlException (transient)&#xa;  BrokerUnreachableException&#xa;  IOException (network)&#xa;  TimeoutException&#xa;  OperationCanceledException (non-shutdown)&#xa;&#xa;Permanent (Failed):&#xa;  UnsupportedFormatException&#xa;  FileCorruptException&#xa;  ConversionException&#xa;  ValidationException&#xa;&#xa;Unknown → transient by default (DLQ catches loops)" style="rounded=0;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;fontFamily=Courier New;" parent="1" vertex="1">
          <mxGeometry x="702" y="791" width="320" height="171" as="geometry" />
