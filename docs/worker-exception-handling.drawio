          <mxGeometry x="875" y="721" width="180" height="44" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Job marked Failed ONLY by:&#xa;  1. Reporter - all expected_files Failed&#xa;  2. TimeoutSweeper - 30min SLA exceeded&#xa;  3. Reporter - manifest never arrived → Timeout&#xa;&#xa;Worker NEVER marks job Failed directly." style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="322" y="791" width="360" height="78" as="geometry" />
