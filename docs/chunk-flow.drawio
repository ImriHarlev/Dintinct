        <mxCell id="s3_5" value="Read file-manifest JSON from disk&lt;br&gt;INSERT expected_file(status=&#39;Pending&#39;, expected_chunk_count=N)&lt;br&gt;INSERT expected_chunk rows&lt;br&gt;ON CONFLICT DO NOTHING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="s3" vertex="1">
