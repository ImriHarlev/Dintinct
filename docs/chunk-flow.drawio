        <mxCell id="s2_4" value="INSERT job(status=&#39;Awaiting&#39;,&lt;br&gt;  expected_file_count=$totalSourceFiles,&lt;br&gt;  job_header_received_at=now())&lt;br&gt;ON CONFLICT DO NOTHING" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="s2" vertex="1">
