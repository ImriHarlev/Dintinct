        <mxCell id="s2_d1" value="Buffered FileManifests&lt;br&gt;for this job_id?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="s2" vertex="1">
