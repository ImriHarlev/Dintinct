        <mxCell id="s3_6" value="&lt;b&gt;INLINE DRAIN:&lt;/b&gt;&lt;br&gt;UPDATE expected_chunk ec SET received_at=i.received_at&lt;br&gt;FROM inbox i&lt;br&gt;WHERE i.kind=&#39;Chunk&#39; AND i.published=FALSE&lt;br&gt;AND ec.name=filename(i.file_path)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="s3" vertex="1">
