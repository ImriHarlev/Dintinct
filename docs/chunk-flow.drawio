        <mxCell id="s4_7" value="Read chunks from proxy delivery dir (in-place)&lt;br&gt;concat → work/{job_id}/assembled/{file_id}.bin&lt;br&gt;INSERT outbox(files.assembled)&lt;br&gt;post-COMMIT: best-effort delete consumed chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" parent="s4" vertex="1">
