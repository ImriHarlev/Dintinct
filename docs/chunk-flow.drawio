          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2_note" value="Delayed job-header → many buffered&lt;br&gt;rows. Job row committed first, then&lt;br&gt;drain in BOUNDED BATCHES&lt;br&gt;(DRAIN_BATCH=500/tx), loop until&lt;br&gt;empty. Locks bounded per batch;&lt;br&gt;resumes idempotently on redelivery." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontSize=9;fontStyle=2;" parent="s2" vertex="1">
          <mxGeometry x="240" y="400" width="150" height="90" as="geometry" />
