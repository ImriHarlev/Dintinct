        <mxCell id="s2_7" value="Concat complete files&lt;br&gt;INSERT outbox(files.assembled)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="s2" vertex="1">
