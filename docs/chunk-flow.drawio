        <mxCell id="s2_8" value="UPDATE job SET status=&#39;Assembling&#39;&lt;br&gt;WHERE status=&#39;Awaiting&#39;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" parent="s2" vertex="1">
