        <mxCell id="s3_9" value="Read chunks from proxy delivery dir&lt;br&gt;concat → work/{job_id}/assembled/{file_id}.bin&lt;br&gt;(.tmp + rename)&lt;br&gt;INSERT outbox(files.assembled)&lt;br&gt;UPDATE job SET status=&#39;Assembling&#39;&lt;br&gt;COMMIT → ack&lt;br&gt;post-COMMIT: best-effort delete consumed chunks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;" parent="s3" vertex="1">
