        <mxCell id="p3a" value="BEGIN tx" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="215" y="158" width="70" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="200" as="sourcePoint" />
            <mxPoint x="430" y="200" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3l" value="done-CAS: SET status=&#39;Done&#39; WHERE status=&#39;Prev&#39; (wins)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="220" y="182" width="240" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p4" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="230" as="sourcePoint" />
            <mxPoint x="430" y="230" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p4l" value="INSERT outbox(queue=&#39;next.queue&#39;, payload, published_at=NULL)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="220" y="212" width="240" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p5" style="endArrow=block;endFill=1;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="260" as="sourcePoint" />
            <mxPoint x="250" y="260" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p5l" value="COMMIT ✓  (row advanced + outbox row durable)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="220" y="262" width="240" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="CRASH ✕" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" parent="1" vertex="1">
          <mxGeometry x="200" y="294" width="100" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p6b" value="Dies between COMMIT and ack.  Inbound never acked." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="310" y="300" width="300" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="RabbitMQ redelivers the inbound message. New worker: done-CAS WHERE status=&#39;Prev&#39; → 0 rows (status already &#39;Done&#39;) → ack + exit. Inbound consumed. &#xa;The downstream message was never published by the worker — but the outbox row is durable." style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="340" width="931" height="40" as="geometry" />
        </mxCell>
        <mxCell id="gap" style="endArrow=none;strokeColor=#CC0000;dashed=1;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30" y="398" as="sourcePoint" />
            <mxPoint x="970" y="398" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gapl" value="Outbox Relay polls every ~500ms.  No age threshold — any row with published_at IS NULL is pending.  ~500ms recovery." style="text;html=1;strokeColor=none;fillColor=#FFE6E6;align=center;fontSize=10;fontStyle=2;" parent="1" vertex="1">
          <mxGeometry x="100" y="401" width="760" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p8" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="620" y="446" as="sourcePoint" />
            <mxPoint x="430" y="446" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p8l" value="SELECT ... FROM outbox WHERE published_at IS NULL FOR UPDATE SKIP LOCKED LIMIT 100" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="390" y="428" width="250" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p9" style="endArrow=block;endFill=1;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="476" as="sourcePoint" />
            <mxPoint x="620" y="476" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p9l" value="RETURNING [outbox row for job-42]" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="390" y="478" width="250" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p10" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="620" y="512" as="sourcePoint" />
            <mxPoint x="815" y="512" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p10l" value="publish next-step message + publisher-confirm (sync)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="600" y="494" width="240" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p11" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="620" y="546" as="sourcePoint" />
            <mxPoint x="430" y="546" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p11l" value="UPDATE outbox SET published_at=now() WHERE id=$1  (only after confirm)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="390" y="528" width="260" height="16" as="geometry" />
        </mxCell>
        <mxCell id="p12" value="Next worker triggered ✓" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="710" y="578" width="170" height="28" as="geometry" />
        </mxCell>
        <mxCell id="cmp" value="Why the outbox is still required (independent of the sweeper removal):&#xa;• The done-CAS + COMMIT advances the row, but the downstream Rabbit publish is a SEPARATE side effect. &#xa;   A crash between COMMIT and publish would otherwise strand the job — the inbound message redelivers but short-circuits (status already &#39;Done&#39;), so it never re-publishes downstream.&#xa;• Outbox closes that gap: relay detects published_at IS NULL → ~500ms recovery, no tuning, uniform across all workers. Publisher-confirm is mandatory.&#xa;• At 1M jobs/month this post-COMMIT window is hit ~3–6×/month — each would be a silently stuck job without the outbox." style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="624" width="900" height="96" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="4 — Deadlock Recovery (Watchdog + A-Sweeper)" id="watchdog-sweeper-recovery">
    <mxGraphModel dx="1577" dy="865" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1040" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="d4-t" value="Deadlock / hung-worker recovery: client-side WATCHDOG (primary, seconds) + TimeoutSweeper-A (job-level SLA backstop)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="20" y="8" width="1000" height="26" as="geometry" />
        </mxCell>
        <mxCell id="d4-rb" value="RabbitMQ" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="44" width="110" height="36" as="geometry" />
        </mxCell>
        <mxCell id="d4-wa" value="Worker A (hangs)" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="220" y="44" width="110" height="36" as="geometry" />
        </mxCell>
        <mxCell id="d4-pg" value="PostgreSQL" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="400" y="44" width="110" height="36" as="geometry" />
        </mxCell>
        <mxCell id="d4-wc" value="Worker C" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="600" y="44" width="110" height="36" as="geometry" />
        </mxCell>
        <mxCell id="d4-sw" value="TimeoutSweeper-A&#xa;(on OutboxRelay-A replica)" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="820" y="44" width="180" height="36" as="geometry" />
        </mxCell>
        <mxCell id="d4-ll-rb" style="endArrow=none;dashed=1;strokeColor=#d6b656;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" y="80" as="sourcePoint" />
            <mxPoint x="95" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-ll-wa" style="endArrow=none;dashed=1;strokeColor=#6c8ebf;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="275" y="80" as="sourcePoint" />
            <mxPoint x="275" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-ll-pg" style="endArrow=none;dashed=1;strokeColor=#82b366;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="455" y="80" as="sourcePoint" />
            <mxPoint x="455" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-ll-wc" style="endArrow=none;dashed=1;strokeColor=#6c8ebf;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="655" y="80" as="sourcePoint" />
            <mxPoint x="655" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-ll-sw" style="endArrow=none;dashed=1;strokeColor=#9673a6;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="80" as="sourcePoint" />
            <mxPoint x="910" y="780" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-f1" value="① WATCHDOG — primary deadlock reclaim (reclaims faster than consumer_timeout; seconds)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#2D7600;" parent="1" vertex="1">
          <mxGeometry x="40" y="90" width="700" height="18" as="geometry" />
        </mxCell>
        <mxCell id="d4-d1" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" y="134" as="sourcePoint" />
            <mxPoint x="275" y="134" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-d1l" value="deliver job-42 (prefetch=1)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="95" y="116" width="180" height="16" as="geometry" />
        </mxCell>
        <mxCell id="d4-d2" value="Worker A: start CancellationTokenSource(maxStepDuration ≈ 3–4× phase p99); begin idempotent work (status still &#39;Prev&#39;)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="165" y="150" width="543" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d4-d3" value="DEADLOCK / hang ✕  (connection alive — broker would otherwise wait the full consumer_timeout)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="165" y="196" width="473" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d4-d4" value="Watchdog fires at maxStepDuration → token cancelled → ProcessMessageAsync throws OperationCanceledException → classified transient" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="150" y="242" width="681" height="44" as="geometry" />
        </mxCell>
        <mxCell id="d4-d5" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="275" y="308" as="sourcePoint" />
            <mxPoint x="95" y="308" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-d5l" value="nack(requeue=false) → channel closes (or retry-queue hop); x-death++ feeds max_retries=5" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="95" y="290" width="320" height="16" as="geometry" />
        </mxCell>
        <mxCell id="d4-gap1" style="endArrow=none;strokeColor=#2D7600;dashed=1;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30" y="330" as="sourcePoint" />
            <mxPoint x="1010" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-gap1l" value="RabbitMQ requeues the unacked delivery in SECONDS — no consumer_timeout wait. The row never left &#39;Prev&#39;, so a fresh worker just reprocesses." style="text;html=1;strokeColor=none;fillColor=#E6FFE6;align=center;fontSize=10;fontStyle=2;" parent="1" vertex="1">
          <mxGeometry x="120" y="333" width="800" height="20" as="geometry" />
        </mxCell>
        <mxCell id="d4-d6" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="95" y="380" as="sourcePoint" />
            <mxPoint x="655" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-d6l" value="redeliver job-42 → Worker C" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="95" y="362" width="560" height="16" as="geometry" />
        </mxCell>
        <mxCell id="d4-d7" value="Worker C: re-run idempotent work (deterministic names → identical bytes)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="545" y="396" width="336" height="38" as="geometry" />
        </mxCell>
        <mxCell id="d4-d8" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="655" y="464" as="sourcePoint" />
            <mxPoint x="455" y="464" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-d8l" value="done-CAS SET status=&#39;Done&#39; WHERE status=&#39;Prev&#39; (wins) + outbox + counter; COMMIT ✓" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="415" y="446" width="320" height="16" as="geometry" />
        </mxCell>
        <mxCell id="d4-d10" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="655" y="496" as="sourcePoint" />
            <mxPoint x="95" y="496" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-d10l" value="Ack (after COMMIT)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="95" y="478" width="560" height="16" as="geometry" />
        </mxCell>
        <mxCell id="d4-d11" value="Reclaimed ✓ (seconds)" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="585" y="520" width="170" height="26" as="geometry" />
        </mxCell>
        <mxCell id="d4-gap2" style="endArrow=none;strokeColor=#CC0000;dashed=1;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30" y="566" as="sourcePoint" />
            <mxPoint x="1010" y="566" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-f2" value="② BACKSTOP — watchdog-evading hang OR wedged dead-letter target → a source_file is stranded non-terminal forever" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=12;fontStyle=1;fontColor=#B85450;" parent="1" vertex="1">
          <mxGeometry x="40" y="572" width="960" height="18" as="geometry" />
        </mxCell>
        <mxCell id="d4-s0" value="PostgreSQL state: source_file stuck at e.g. &#39;Converted&#39; (never reached terminal) &#xa;→ files_manifest_written_count &lt; total_source_files → job NOT &#39;AllManifestsWritten&#39;." style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="290" y="598" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d4-s1" value="TimeoutSweeper-A: cron every 60s on the SWEEPER_ENABLED replica. &#xa;No -ing states, no per-row heartbeat, no schema change." style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="680" y="598" width="333" height="40" as="geometry" />
        </mxCell>
        <mxCell id="d4-s2" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="664" as="sourcePoint" />
            <mxPoint x="455" y="664" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-s2l" value="SELECT job WHERE status NOT IN (&#39;AllManifestsWritten&#39;,&#39;Failed&#39;) AND now()-created_at &gt; 30min  FOR UPDATE SKIP LOCKED" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="445" y="646" width="480" height="16" as="geometry" />
        </mxCell>
        <mxCell id="d4-s3" value="Write-before-commit (§3.7): write Failed mini-manifest {status:&#39;Failed&#39;, failureReason:&#39;SweeperTimeout&#39;, chunks:[]} &#xa;to the manifest outbox dir BEFORE the commit, so NetworkB always learns the file failed." style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="676" width="512" height="34" as="geometry" />
        </mxCell>
        <mxCell id="d4-s4" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="910" y="736" as="sourcePoint" />
            <mxPoint x="455" y="736" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="d4-s4l" value="UPDATE source_file SET status=&#39;Failed&#39; WHERE NOT terminal (CAS — exactly-once); counter += k → flips job to &#39;AllManifestsWritten&#39; (same tx); COMMIT" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="445" y="718" width="480" height="16" as="geometry" />
        </mxCell>
        <mxCell id="d4-s5" value="NetworkB receives the Failed mini-manifest → expected_file created terminal, no chunks awaited. Job converges instead of hanging indefinitely. ✓" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="120" y="744" width="780" height="28" as="geometry" />
        </mxCell>
        <mxCell id="d4-foot" value="• Watchdog (①) is the common-case reclaim — seconds, faster than consumer_timeout (the coarse quorum backstop).&#xa;• TimeoutSweeper-A (②) is the rare-case SLA backstop: a hang the watchdog can&#39;t catch, or a message wedged behind a full/unavailable dead-letter target. Defense-in-depth (RabbitMQ 3.13, quorum).&#xa;• Both gated by the terminal-status CAS → exactly-once even if a slow-but-healthy worker finishes the same file concurrently (one of {worker, sweeper} flips it).&#xa;• Mirrors Network B §5.7 TimeoutSweeper; SLA = 30 min from job.created_at (align with B)." style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="20" y="788" width="1000" height="80" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
