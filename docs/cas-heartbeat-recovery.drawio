          </mxGeometry>
        </mxCell>
        <mxCell id="ll-or" style="endArrow=none;dashed=1;strokeColor=#9673a6;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="620" y="80" as="sourcePoint" />
            <mxPoint x="620" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-rbn" style="endArrow=none;dashed=1;strokeColor=#d6b656;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="815" y="80" as="sourcePoint" />
            <mxPoint x="815" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p1" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="120" as="sourcePoint" />
