          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="545" as="sourcePoint" />
            <mxPoint x="470" y="545" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r10l" value="UPDATE status=&#39;Pending&#39; WHERE status=&#39;Parsing&#39; AND hb &lt; now()-30s RETURNING id" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="420" y="527" width="420" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r11" style="endArrow=block;endFill=1;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="575" as="sourcePoint" />
            <mxPoint x="830" y="575" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r11l" value="RETURNING [42]  (stale job reset to Pending)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="420" y="577" width="420" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r12" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="830" y="612" as="sourcePoint" />
            <mxPoint x="470" y="612" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r12l" value="INSERT outbox(queue=prev.queue, payload) — durable, NOT a direct publish" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="470" y="594" width="400" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r12b" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="648" as="sourcePoint" />
            <mxPoint x="110" y="648" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r12bl" value="OutboxRelay publishes NEW job-42 (publisher-confirm; see Diagram 3)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="110" y="632" width="540" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r13" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="684" as="sourcePoint" />
            <mxPoint x="650" y="684" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r13l" value="deliver job-42 (new message) → Worker C" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="110" y="668" width="540" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r14" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="720" as="sourcePoint" />
            <mxPoint x="470" y="720" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r14l" value="CAS WHERE status=&#39;Pending&#39; → SUCCESS" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="440" y="702" width="240" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r15" value="Process + Complete ✓" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="590" y="754" width="140" height="28" as="geometry" />
        </mxCell>
        <mxCell id="why" value="Why sweeper-only (no expanded CAS):&#xa;• Batch system — 24h SLA. ~90s recovery latency is negligible.&#xa;• Simpler CAS. No per-phase threshold tuning for steal logic.&#xa;• Expanded CAS adds complexity without meaningful gain here.&#xa;• Add it later only if recovery latency becomes a real constraint." style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="60" y="800" width="560" height="76" as="geometry" />
        </mxCell>
        <mxCell id="sweeper-note" value="Note: Sweeper resets ONLY:&#xa;  status → &#39;Pending&#39;&#xa;  worker_id → NULL&#xa;  last_heartbeat_at → NULL&#xa;It does NOT reset manifest_written.&#xa;(manifest_written is sticky once TRUE)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="854" y="531" width="280" height="82" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 — Post-COMMIT Crash (Outbox)" id="outbox-recovery">
    <mxGraphModel dx="1317" dy="687" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="Post-COMMIT Crash: COMMIT succeeds → crash → Rabbit publish never happens → Outbox Relay rescues" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="8" width="880" height="26" as="geometry" />
        </mxCell>
        <mxCell id="a-rb" value="RabbitMQ&#xa;(Inbound)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="44" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-wa" value="Worker A" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="200" y="44" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-pg" value="PostgreSQL" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="380" y="44" width="100" height="36" as="geometry" />
