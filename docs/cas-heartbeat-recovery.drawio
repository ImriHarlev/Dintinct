<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/28.2.5 Chrome/138.0.7204.251 Electron/37.6.1 Safari/537.36" version="28.2.5" pages="4">
  <diagram name="1 — Normal Flow" id="normal-flow">
    <mxGraphModel dx="1200" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="640" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" value="Normal Flow: Idempotent Work → done-CAS → Commit → Ack" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="10" width="640" height="26" as="geometry" />
        </mxCell>
        <!-- actors -->
        <mxCell id="a-rb" value="RabbitMQ" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="46" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-wa" value="Worker A" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="240" y="46" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-pg" value="PostgreSQL" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="420" y="46" width="100" height="36" as="geometry" />
        </mxCell>
        <!-- lifelines -->
        <mxCell id="ll-rb" style="endArrow=none;dashed=1;strokeColor=#d6b656;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="82" as="sourcePoint" />
            <mxPoint x="110" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-wa" style="endArrow=none;dashed=1;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="82" as="sourcePoint" />
            <mxPoint x="290" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-pg" style="endArrow=none;dashed=1;strokeColor=#82b366;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="82" as="sourcePoint" />
            <mxPoint x="470" y="540" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <!-- step 1: deliver -->
        <mxCell id="s1" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="130" as="sourcePoint" />
            <mxPoint x="290" y="130" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s1l" value="deliver job-42 (prefetch=1)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="112" width="180" height="16" as="geometry" />
        </mxCell>
        <!-- step 2: idempotent work (no claim, no -ing state) -->
        <mxCell id="s2" value="Do idempotent work (no claim / no -ing state):&#xa;• write deterministically-named files (.tmp+rename; proxy ignores .tmp)&#xa;• INSERT child rows ON CONFLICT DO NOTHING" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="250" y="156" width="320" height="48" as="geometry" />
        </mxCell>
        <!-- step 3: BEGIN tx -->
        <mxCell id="s3a" value="BEGIN tx" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="255" y="214" width="70" height="20" as="geometry" />
        </mxCell>
        <!-- step 4: done-CAS -->
        <mxCell id="s4" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="262" as="sourcePoint" />
            <mxPoint x="470" y="262" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s4l" value="done-CAS: UPDATE SET status=&#39;Done&#39; WHERE id=42 AND status=&#39;Prev&#39; RETURNING id" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="244" width="320" height="16" as="geometry" />
        </mxCell>
        <!-- step 5: returning won -->
        <mxCell id="s5" style="endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="292" as="sourcePoint" />
            <mxPoint x="290" y="292" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s5l" value="RETURNING id (won) — only the winner continues" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="294" width="320" height="16" as="geometry" />
        </mxCell>
        <!-- step 6: outbox insert (gated on CAS win) -->
        <mxCell id="s6" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="324" as="sourcePoint" />
            <mxPoint x="470" y="324" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s6l" value="INSERT outbox(next.queue, payload, published_at=NULL) + counter increment (same tx)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="250" y="316" width="320" height="16" as="geometry" />
        </mxCell>
        <!-- step 7: commit -->
        <mxCell id="s7" style="endArrow=block;endFill=1;dashed=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="354" as="sourcePoint" />
            <mxPoint x="290" y="354" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s7l" value="COMMIT ✓" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="250" y="356" width="320" height="16" as="geometry" />
        </mxCell>
        <!-- step 8: ack (after commit) -->
        <mxCell id="s8" style="endArrow=block;endFill=1;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="388" as="sourcePoint" />
            <mxPoint x="110" y="388" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="s8l" value="Ack message (ONLY after COMMIT)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="110" y="370" width="180" height="16" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="Complete ✓" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="240" y="420" width="120" height="28" as="geometry" />
        </mxCell>
        <!-- config note -->
        <mxCell id="cfg" value="Recovery config (deployment / broker / app — NOT a DB heartbeat):&#xa;  Client-side WATCHDOG = CancellationTokenSource(maxStepDuration ≈ 3–4× phase p99)&#xa;     → primary hung-worker reclaim; faster than consumer_timeout; seconds (see Page 4)&#xa;  RabbitMQ consumer_timeout = 30min default  (quorum; coarse backstop)&#xa;  AMQP connection heartbeat = 60s  (dead after 2 missed)&#xa;  prefetch = 1 per consumer channel&#xa;  quorum delivery-limit = 20  (NO default on 3.13 — set via policy; + app max_retries=5)&#xa;phase_config table:  max_retries = 5  (no heartbeat/sweeper columns)&#xa;Queues: QUORUM only — RabbitMQ 3.13, 3-node cluster per network" style="rounded=1;fillColor=#f5f5f5;strokeColor=#666;fontFamily=Courier New;fontSize=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="60" y="452" width="600" height="146" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="2 — Crash Recovery (Broker Redelivery)" id="redelivery-recovery">
    <mxGraphModel dx="1921" dy="1002" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t2" value="Crash Recovery (pre-COMMIT): Worker crashes → channel closes → RabbitMQ requeues → another worker reprocesses" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="8" width="920" height="26" as="geometry" />
        </mxCell>
        <mxCell id="a-rb" value="RabbitMQ" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="60" y="44" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-wa" value="Worker A" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="240" y="44" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-pg" value="PostgreSQL" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="420" y="44" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-wb" value="Worker B / C" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="600" y="44" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ll-rb" style="endArrow=none;dashed=1;strokeColor=#d6b656;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="80" as="sourcePoint" />
            <mxPoint x="110" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-wa" style="endArrow=none;dashed=1;strokeColor=#6c8ebf;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="80" as="sourcePoint" />
            <mxPoint x="290" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-pg" style="endArrow=none;dashed=1;strokeColor=#82b366;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="80" as="sourcePoint" />
            <mxPoint x="470" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-wb" style="endArrow=none;dashed=1;strokeColor=#6c8ebf;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="80" as="sourcePoint" />
            <mxPoint x="650" y="620" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r1" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="124" as="sourcePoint" />
            <mxPoint x="290" y="124" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r1l" value="deliver job-42" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="110" y="106" width="180" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Worker A: do idempotent work&#xa;(status still &#39;Prev&#39; — no claim flip yet)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="180" y="144" width="220" height="38" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="CRASH ✕ (pre-COMMIT)" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=12;" parent="1" vertex="1">
          <mxGeometry x="215" y="194" width="150" height="26" as="geometry" />
        </mxCell>
        <mxCell id="r3b" value="No ack sent. DB unchanged (row still &#39;Prev&#39;)." style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="372" y="198" width="240" height="16" as="geometry" />
        </mxCell>
        <mxCell id="gap" style="endArrow=none;strokeColor=#CC0000;dashed=1;strokeWidth=2;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="30" y="244" as="sourcePoint" />
            <mxPoint x="970" y="244" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gapl" value="RabbitMQ requeues the unacked delivery when the channel/connection closes. Crash/OOM/redeploy → seconds. Network partition → ~60s (AMQP heartbeat). App deadlock (live conn)&amp;nbsp;&lt;div&gt;→ CLIENT-SIDE WATCHDOG self-cancels in ~maxStepDuration (seconds; faster than consumer_timeout)&amp;nbsp;&lt;/div&gt;&lt;div&gt;— consumer_timeout is the slower broker backstop (see Page 4). No sweeper needed — the row never left &#39;Prev&#39;, so a redelivery simply reprocesses.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=#FFE6E6;align=center;fontSize=10;fontStyle=2;" parent="1" vertex="1">
          <mxGeometry x="80" y="247" width="840" height="45" as="geometry" />
        </mxCell>
        <mxCell id="r4" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="110" y="306" as="sourcePoint" />
            <mxPoint x="650" y="306" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r4l" value="redeliver job-42 (unacked → requeued) → Worker C" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="110" y="288" width="540" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="Worker C: re-run idempotent work&#xa;(deterministic names → identical bytes)" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="540" y="326" width="220" height="38" as="geometry" />
        </mxCell>
        <mxCell id="r6" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="396" as="sourcePoint" />
            <mxPoint x="470" y="396" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r6l" value="done-CAS: SET status=&#39;Done&#39; WHERE id=42 AND status=&#39;Prev&#39;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="430" y="378" width="290" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r7" style="endArrow=block;endFill=1;dashed=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="470" y="426" as="sourcePoint" />
            <mxPoint x="650" y="426" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r7l" value="RETURNING id (won — state was still &#39;Prev&#39;)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="430" y="428" width="290" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r8" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="458" as="sourcePoint" />
            <mxPoint x="470" y="458" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r8l" value="INSERT outbox(next.queue) + counter; COMMIT ✓" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="430" y="440" width="290" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r9" style="endArrow=block;endFill=1;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="650" y="492" as="sourcePoint" />
            <mxPoint x="110" y="492" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r9l" value="Ack message (after COMMIT)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="110" y="474" width="540" height="16" as="geometry" />
        </mxCell>
        <mxCell id="r10" value="Process + Complete ✓" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="590" y="520" width="150" height="28" as="geometry" />
        </mxCell>
        <mxCell id="why" value="Why broker-redelivery + client-side watchdog (no per-phase sweeper):&#xa;• Crash/OOM/redeploy recover in SECONDS — faster than the old ~90s sweeper, because there is no &#39;-ing&#39; row to block the redelivery from reprocessing.&#xa;• Idempotent consumers are mandatory under at-least-once regardless, so nothing new is required.&#xa;• App-deadlock-with-live-connection: the client-side WATCHDOG self-cancels in ~maxStepDuration (primary deadlock reclaim — faster than consumer_timeout). Page 4.&#xa;• Job-level backstops if a row is still stranded: TimeoutSweeper (B) and files_manifest_written_count counter + per-file DLQ-terminal + TimeoutSweeper-A (A, §3.7).&#xa;• A concurrent duplicate (watchdog/timeout requeue while A is still alive) re-runs idempotently and loses the done-CAS → harmless." style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;" parent="1" vertex="1">
          <mxGeometry x="40" y="560" width="920" height="104" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="3 — Post-COMMIT Crash (Outbox)" id="outbox-recovery">
    <mxGraphModel dx="1921" dy="1002" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1000" pageHeight="780" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t3" value="Post-COMMIT Crash: COMMIT succeeds → crash before ack/publish → Outbox Relay publishes the durable row" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=14;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="40" y="8" width="900" height="26" as="geometry" />
        </mxCell>
        <mxCell id="a-rb" value="RabbitMQ&#xa;(Inbound)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="40" y="44" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-wa" value="Worker A" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="200" y="44" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-pg" value="PostgreSQL" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="380" y="44" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-or" value="Outbox Relay" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="570" y="44" width="100" height="36" as="geometry" />
        </mxCell>
        <mxCell id="a-rbn" value="RabbitMQ&#xa;(Next Queue)" style="rounded=1;fillColor=#ffe6cc;strokeColor=#d6b656;fontStyle=1;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="760" y="44" width="110" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ll-rb" style="endArrow=none;dashed=1;strokeColor=#d6b656;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="90" y="80" as="sourcePoint" />
            <mxPoint x="90" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-wa" style="endArrow=none;dashed=1;strokeColor=#6c8ebf;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="250" y="80" as="sourcePoint" />
            <mxPoint x="250" y="640" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ll-pg" style="endArrow=none;dashed=1;strokeColor=#82b366;" parent="1" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="430" y="80" as="sourcePoint" />
