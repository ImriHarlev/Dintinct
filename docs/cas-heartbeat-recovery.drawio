        </mxCell>
        <mxCell id="p2" value="Worker A: do idempotent work (status still &#39;Prev&#39;)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;fontStyle=2;" parent="1" vertex="1">
          <mxGeometry x="230" y="134" width="220" height="16" as="geometry" />
