            <mxPoint x="980" y="498" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="gapl" value="Sweeper fires every 60s.  Threshold = 3× heartbeat_interval = 30s.  Worst-case recovery = threshold + sweeper_interval = ~90s." style="text;html=1;strokeColor=none;fillColor=#FFE6E6;align=center;fontSize=10;fontStyle=2;" parent="1" vertex="1">
          <mxGeometry x="100" y="501" width="760" height="24" as="geometry" />
        </mxCell>
