            <mxPoint x="650" y="424" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="r8l" value="0 rows  (status=&#39;Parsing&#39; ≠ &#39;Pending&#39;)" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="440" y="426" width="240" height="16" as="geometry" />
